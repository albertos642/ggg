menuconfig GGG_SYSTEM_BUS
    bool "SystemBus Event Dispatcher Subsystem"
    default y
    help
      Enables the Zero-Malloc SystemBus event queue dispatcher based on static FreeRTOS queue.

if GGG_SYSTEM_BUS

config GGG_SYSTEM_BUS_MAX_LISTENERS
    int "Maximum Registered Listeners"
    default 10
    help
      Maximum number of observers/plugins that can subscribe to the SystemBus simultaneously.

endif
