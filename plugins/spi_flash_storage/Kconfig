menuconfig GGG_PLUGIN_SPI_FLASH_STORAGE
    bool "SPI Flash Storage Plugin (IStorage)"
    default n
    help
      Enables non-volatile SPI NOR Flash block storage implementing
      the ggg::hal::IStorage interface for persistent transactional storage.

if GGG_PLUGIN_SPI_FLASH_STORAGE

    choice
        prompt "SPI Bus Configuration Mode"
        default GGG_SPIFLASH_USE_HARDWARE_SPI
        help
          Select whether to use the default microcontroller hardware SPI peripheral
          or explicitly define custom GPIO pins for SPI signals.

    config GGG_SPIFLASH_USE_HARDWARE_SPI
        bool "Hardware SPI Peripheral"
        help
          Uses standard MCU hardware SPI peripheral (SPIClass / default SPI bus).

    config GGG_SPIFLASH_USE_CUSTOM_PINS
        bool "Custom SPI Pins"
        help
          Explicitly configure SCK, MOSI, and MISO GPIO pins.

    endchoice

    config GGG_SPIFLASH_CS_PIN
        int "Chip Select (CS) GPIO Pin"
        default 5
        help
          GPIO pin connected to the flash Chip Select (/CS) line.
          NOTE: On Adafruit Feather M0 LoRa, Pin 4 is the LoRa RESET line and Pin 8
          is LoRa CS. Use Pin 5 (or 6, 10, 11, 12) for external SPI Flash CS.

    if GGG_SPIFLASH_USE_CUSTOM_PINS
        config GGG_SPIFLASH_SCK_PIN
            int "SCK Pin Number"
            default 24
            help
              GPIO pin connected to SPI Clock (SCK).

        config GGG_SPIFLASH_MOSI_PIN
            int "MOSI Pin Number"
            default 23
            help
              GPIO pin connected to SPI Master Out Slave In (MOSI).

        config GGG_SPIFLASH_MISO_PIN
            int "MISO Pin Number"
            default 22
            help
              GPIO pin connected to SPI Master In Slave Out (MISO).
    endif

    choice
        prompt "SPI Flash Chip Model"
        default GGG_SPIFLASH_CHIP_W25Q64
        help
          Select the exact Winbond W25Q-series SPI NOR Flash chip model in use.

    config GGG_SPIFLASH_CHIP_W25Q16
        bool "Winbond W25Q16 (16 Mbit / 2 MByte, 512 sectors)"

    config GGG_SPIFLASH_CHIP_W25Q32
        bool "Winbond W25Q32 (32 Mbit / 4 MByte, 1024 sectors)"

    config GGG_SPIFLASH_CHIP_W25Q64
        bool "Winbond W25Q64 (64 Mbit / 8 MByte, 2048 sectors)"

    config GGG_SPIFLASH_CHIP_W25Q128
        bool "Winbond W25Q128 (128 Mbit / 16 MByte, 4096 sectors)"

    endchoice

    config GGG_SPIFLASH_STORAGE_BASE_OFFSET
        hex "Flash Storage Base Offset (Bytes)"
        default 0x000000
        help
          Start address in flash reserved for GGG IStorage records.
          Allows sharing flash memory with bootloaders or filesystems.

    config GGG_SPIFLASH_MAX_RECORDS
        int "Maximum Concurrent Storage Records"
        default 16
        range 2 64
        help
          Maximum number of active transactional records tracked concurrently.

    config GGG_SPIFLASH_SECTOR_SIZE
        int "Flash Sector Size (Bytes)"
        default 4096
        help
          Hardware sector erase size (typically 4096 bytes for Winbond W25Q).

endif
